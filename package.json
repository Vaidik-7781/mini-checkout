{
  "name": "mini-checkout",
  "version": "1.0.0",
  "description": "Single-page checkout with Playwright browser tests",
  "scripts": {
    "start": "node server.js",
    "test": "playwright test --project=chromium",
    "test:chrome": "playwright test --project=chrome",
    "test:required": "playwright test tests/checkout.spec.js --project=chromium",
    "test:headed": "playwright test --project=chromium --headed --workers=1",
    "test:repeat": "playwright test --project=chromium --repeat-each=10",
    "report": "playwright show-report",
    "evidence": "node scripts/exploratory-evidence.js evidence/latest",
    "mutation": "node scripts/mutation-check.js"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  }
}
